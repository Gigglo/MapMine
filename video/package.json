{
  "name": "mapmine-launch-video",
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio .production/index.tsx",
    "typecheck": "tsc -p .production/tsconfig.json",
    "render:landscape": "remotion render .production/index.tsx MapMineLaunch out/mapmine-launch.mp4 --codec=h264 --x264-preset=veryfast",
    "render:vertical": "remotion render .production/index.tsx MapMineVertical out/mapmine-vertical.mp4 --codec=h264 --x264-preset=veryfast"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.545",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.545",
    "typescript": "^7.0.2"
  },
  "private": true
}
