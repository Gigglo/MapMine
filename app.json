{
  "expo": {
    "name": "MapMine",
    "slug": "MapMine",
    "version": "1.0.0",
    "scheme": "mapmine",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.mapmine.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mapmine.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo.png",
        "backgroundImage": "./assets/logo.png",
        "monochromeImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-status-bar",
      "expo-router",
      "expo-sharing",
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "MapMine uses your location to record journeys and reveal territory when the screen is locked or another app is open.",
          "locationWhenInUsePermission": "MapMine uses your location while open to reveal territory and record your journeys."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/android-icon-monochrome.png",
          "imageWidth": 96,
          "backgroundColor": "#0A0A0A",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose an image to use as your MapMine logo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-asset",
        {
          "assets": [
            "./assets/india_landmarks_v2.db"
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "MapMineExploration",
              "displayName": "MapMine Exploration",
              "description": "See your latest travel distance and unlocked territory.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "src/features/engagement/ExplorationWidget.ios.tsx"
              },
              "android": {
                "targetCellWidth": 3,
                "targetCellHeight": 2,
                "initialLayout": "src/features/engagement/ExplorationWidget.android.tsx"
              }
            }
          ]
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.mapmine.app.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.mapmine.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "92159e59-caa7-4317-96fa-f12f4864e0a7"
      }
    }
  }
}
